<?xml version="1.0" encoding="UTF-8"?>
<!--
  ====================================================================================
  fatjar-generator : 代码生成器模块
  ====================================================================================
  职责：
    基于 MyBatis-Plus 3.5.5 FastAutoGenerator + Velocity 模板引擎，
    依据数据库表结构反向生成 Entity / Mapper / Mapper.xml / Service / ServiceImpl / Controller
    全套 CRUD 脚手架代码，加速业务模块开发。
  特性：
    1. 开箱即用：默认连接本地 fatjar 库，main 方法直接运行即可生成
    2. 全中文注释：所有生成代码携带作者 fatjar / since 1.0.0 信息
    3. 与项目规范对齐：Lombok 链式实体、@TableName、@Mapper、@RestController、逻辑删除 deleted
  依赖来源：
    版本号由 fatjar-dependencies BOM 统一锁定，本模块仅声明 groupId+artifactId，不写 version。
  ====================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============ 继承顶层父 POM ============ -->
    <parent>
        <groupId>com.workspace.fatjar</groupId>
        <artifactId>fatjar-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fatjar-generator</artifactId>
    <name>fatjar-generator</name>
    <description>代码生成器 - 基于 MyBatis-Plus FastAutoGenerator + Velocity 模板引擎</description>

    <dependencies>
        <!-- ============ 代码生成核心：MyBatis-Plus Generator ============ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-generator</artifactId>
        </dependency>

        <!-- ============ 模板引擎：Velocity（MyBatis-Plus 默认推荐） ============ -->
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
        </dependency>

        <!-- ============ MyBatis-Plus 扩展（注解 + 模板运行时依赖） ============ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>

        <!-- ============ MySQL JDBC 驱动（运行时反射读取表结构） ============ -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- ============ Lombok：生成器自身使用 @Slf4j 日志（provided，不传递） ============ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============ 测试支持（工具模块仅保留测试依赖，不编写业务测试用例） ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
