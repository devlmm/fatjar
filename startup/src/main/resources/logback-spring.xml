<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置文件 logback-spring.xml
  功能：
    1. 控制台彩色输出（开发友好）
    2. 按环境差异化：dev=DEBUG，sit=INFO，prd=WARN（springProfile 标签）
    3. 输出 traceId（由 TraceIdFilter 注入 MDC），便于全链路追踪
    4. 文件滚动：按天 + 100MB 切割，保留 30 天
    5. 兜底默认 root：无论是否激活 profile，启动阶段异常都能输出到控制台，
       便于快速定位数据库/注册中心/缓存连接失败等启动失败原因
-->
<configuration>
    <!-- 应用名 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="fatjar"/>
    <!-- 日志目录 -->
    <property name="LOG_HOME" value="${LOG_HOME:-./logs}"/>

    <!-- 控制台输出（彩色） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%X{traceId:-}) %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件滚动输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %X{traceId:-} %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      兜底默认 root（无任何 springProfile 激活时生效）
      作用：即便忘记在启动参数中设置 spring.profiles.active（可选值 dev/sit/prd），
      启动阶段的异常堆栈也会打印到控制台，避免吞掉真正的启动失败原因。
      激活 profile 时，对应 springProfile 块内的 <root> 会覆盖此默认配置。
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- DEV 环境：DEBUG + 控制台 + 文件 -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.workspace.fatjar" level="DEBUG"/>
    </springProfile>

    <!-- SIT 环境：INFO + 控制台 + 文件 -->
    <springProfile name="sit">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- PRD 环境：WARN + 文件（减少控制台输出） -->
    <springProfile name="prd">
        <root level="WARN">
            <appender-ref ref="FILE"/>
        </root>
        <logger name="com.workspace.fatjar" level="INFO"/>
    </springProfile>
</configuration>
