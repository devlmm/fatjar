<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  ====================================================================================
  SysRoleMapper.xml : 系统角色手写 SQL
  ------------------------------------------------------------------------------------
  namespace 与 Java 接口全限定名一致，由 MyBatis 自动绑定。
  基础 CRUD 由 BaseMapper 提供，此处仅定义自定义方法。
  说明：sys_role 表有 deleted 字段；sys_user_role 为关联中间表无 deleted 字段。
  ====================================================================================
-->
<mapper namespace="com.workspace.fatjar.auth.mapper.SysRoleMapper">

    <!-- 角色结果映射 -->
    <resultMap id="sysRoleResultMap" type="com.workspace.fatjar.auth.entity.SysRole">
        <id column="id" property="id"/>
        <result column="role_code" property="roleCode"/>
        <result column="role_name" property="roleName"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!--
      根据用户 ID 查询其所有关联角色
      关联路径：sys_user_role.user_id -> sys_role.id
      仅返回启用（status=0）且未删除（deleted=0）的角色
    -->
    <select id="selectRolesByUserId" resultMap="sysRoleResultMap">
        SELECT r.id, r.role_code, r.role_name, r.status, r.remark,
               r.create_time, r.update_time, r.create_by, r.update_by, r.deleted
        FROM auth.sys_role r
        INNER JOIN auth.sys_user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND r.deleted = 0
          AND r.status = 0
    </select>
</mapper>
