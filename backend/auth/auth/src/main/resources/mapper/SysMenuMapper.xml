<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  ====================================================================================
  SysMenuMapper.xml : 系统菜单手写 SQL
  ====================================================================================
  namespace 与 Java 接口全限定名一致，由 MyBatis 自动绑定。
  基础 CRUD 由 BaseMapper 提供，此处仅定义自定义方法。
  说明：sys_menu 表有 deleted 字段；sys_role_menu、sys_user_role 为中间表无 deleted 字段。
  关联路径：sys_user_role.user_id -> sys_role.id, sys_role_menu.role_id -> sys_menu.id
  ====================================================================================
-->
<mapper namespace="com.workspace.fatjar.auth.mapper.SysMenuMapper">

    <!-- 菜单结果映射 -->
    <resultMap id="sysMenuResultMap" type="com.workspace.fatjar.auth.domain.SysMenuDO">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="name" property="name"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="icon" property="icon"/>
        <result column="type" property="type"/>
        <result column="permission" property="permission"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!--
      根据用户 ID 查询其可访问的所有菜单
      关联路径：sys_user_role -> sys_role_menu -> sys_menu
      返回结果去重（DISTINCT），仅返回启用（status=0）且未删除的菜单，按 sort 升序排列
    -->
    <select id="selectMenusByUserId" resultMap="sysMenuResultMap">
        SELECT DISTINCT m.id, m.parent_id, m.name, m.path, m.component, m.icon,
               m.type, m.permission, m.sort, m.status,
               m.create_time, m.update_time, m.create_by, m.update_by, m.deleted
        FROM auth.sys_menu m
        INNER JOIN auth.sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN auth.sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND m.deleted = 0
          AND m.status = 0
        ORDER BY m.sort ASC, m.id ASC
    </select>

    <!--
      根据用户 ID 查询其所有权限标识（仅按钮型菜单 type=2 且 permission 非空）
      结果去重，用于接口/按钮鉴权
    -->
    <select id="selectPermissionsByUserId" resultType="java.lang.String">
        SELECT DISTINCT m.permission
        FROM auth.sys_menu m
        INNER JOIN auth.sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN auth.sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND m.deleted = 0
          AND m.status = 0
          AND m.type = 2
          AND m.permission IS NOT NULL
          AND m.permission != ''
    </select>
</mapper>
