<?xml version="1.0" encoding="UTF-8"?>
<!--
  ====================================================================================
  fatjar-auth : 权限模块业务实现（业务本名，无 -impl 后缀）
  ====================================================================================
  职责：
    1. 实现 fatjar-auth-api 暴露的门面契约（AuthApi）
    2. 同时实现内部 AuthService 接口（一个 ServiceImpl 满足双契约）
    3. 提供 Controller 入口（AuthController/SysUser/SysRole/SysMenu）
    4. 集成 Spring Security + JWT + Redis 缓存权限
  依赖：
    - fatjar-auth-api        ：门面契约
    - fatjar-spring-boot-starter-web      ：Web 层（异常/CORS/Knife4j/校验）
    - fatjar-spring-boot-starter-security ：Spring Security + PasswordEncoder（已由 SecurityBaseConfig 注册 Bean）
    - fatjar-spring-boot-starter-mybatis   ：MyBatis-Plus + Druid
    - fatjar-spring-boot-starter-redis     ：Redis + Redisson
    - fatjar-common         ：通用 R/异常/UserContext
    - lombok(provided)
  设计说明：
    1. 不在此模块重复注册 PasswordEncoder Bean（已由 starter-security 的 SecurityBaseConfig 注册，避免冲突）
    2. Mapper 手写 SQL 全部放 resources/mapper 下 XML，Java 接口只保留方法声明 + @Param
  ====================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 auth 聚合根（fatjar-auth-parent），形成嵌套继承链 -->
    <parent>
        <groupId>com.workspace.fatjar</groupId>
        <artifactId>fatjar-auth-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fatjar-auth</artifactId>
    <name>fatjar-auth</name>
    <description>权限模块业务实现 - entity/mapper/service/controller/config/filter/util</description>

    <dependencies>
        <!-- 本模块的门面契约（含 AuthApi + RO + DTO） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-auth-api</artifactId>
        </dependency>

        <!-- 通用模块（R、BizException、UserContext、BaseEntity、CommonConstants 等） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-common</artifactId>
        </dependency>

        <!-- Web 层：统一异常 / CORS / Knife4j 文档 / 校验 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security 基础（含 SecurityBaseConfig 注册 PasswordEncoder Bean） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- MyBatis-Plus + Druid + 分页 / 乐观锁 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Redis + Redisson（缓存 Token/权限/角色） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Lombok：编译期注解处理，provided 作用域不传递 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
