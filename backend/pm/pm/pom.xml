<?xml version="1.0" encoding="UTF-8"?>
<!--
  ====================================================================================
  fatjar-pm : 项目管理模块业务实现（业务本名，无 -impl 后缀）
  ====================================================================================
  职责：
    1. 实现 fatjar-pm-api 暴露的门面契约（PmProjectApi）
    2. 同时实现内部 PmProjectService 接口（一个 ServiceImpl 满足双契约）
    3. 提供 Controller 入口（PmProjectController，CRUD）
    4. 跨模块协作：项目经理存在性校验通过 HrmEmployeeApi 完成
  依赖：
    - fatjar-pm-api         ：本模块门面契约（PmProjectApi + DTO + RO）
    - fatjar-common         ：通用 R/异常/UserContext/BaseEntity
    - fatjar-spring-boot-starter-web      ：Web 层（异常/CORS/Knife4j/校验）
    - fatjar-spring-boot-starter-mybatis   ：MyBatis-Plus + Druid + 分页 / 乐观锁
    - fatjar-hrm-api        ：跨模块门面契约（PM 调用 HRM 员工信息，仅契约不依赖 hrm 实现）
    - lombok(provided)
  跨模块依赖说明：PM 仅依赖 fatjar-hrm-api 契约，由运行期注入 HrmEmployeeApi 的实现
    （由 fatjar-hrm 模块提供 Bean），从而规避 Maven 循环依赖。
  ====================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 pm 聚合根（fatjar-pm-parent），形成嵌套继承链 -->
    <parent>
        <groupId>com.workspace.fatjar</groupId>
        <artifactId>fatjar-pm-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fatjar-pm</artifactId>
    <name>fatjar-pm</name>
    <description>项目管理模块业务实现 - entity/mapper/service/controller（含跨模块 HRM 校验）</description>

    <dependencies>
        <!-- 本模块的门面契约（含 PmProjectApi + DTO + RO） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-pm-api</artifactId>
        </dependency>

        <!-- 通用模块（R、BizException、UserContext、BaseEntity、CommonConstants 等） -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-common</artifactId>
        </dependency>

        <!-- Web 层：统一异常 / CORS / Knife4j 文档 / 校验 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus + Druid + 分页 / 乐观锁 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- 跨模块门面契约：PM 调用 HRM 员工信息 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-hrm-api</artifactId>
        </dependency>

        <!-- Lombok：编译期注解处理，provided 作用域不传递 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MapStruct：BO/DO/VO/DTO 对象转换（版本由 dependencies BOM 管理） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>
</project>
