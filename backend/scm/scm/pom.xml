<?xml version="1.0" encoding="UTF-8"?>
<!--
  ====================================================================================
  fatjar-scm : 供应链管理模块业务实现（业务本名，无 -impl 后缀）
  ====================================================================================
  职责：
    1. 实现 fatjar-scm-api 暴露的门面契约（ScmPurchaseOrderApi）
    2. 同时实现内部 ScmPurchaseOrderService 接口（一个 ServiceImpl 满足双契约）
    3. 提供 Controller 入口（ScmPurchaseOrderController）对外 CRUD
    4. 跨模块编排：采购订单保存前调用 FicoVoucherApi.checkBudget 做预算校验
  依赖：
    - fatjar-scm-api        ：门面契约
    - fatjar-fico-api       ：跨模块门面契约（采购保存前调用 FICO 预算校验）
    - fatjar-common         ：通用 R/异常/UserContext/BaseEntity
    - fatjar-spring-boot-starter-web      ：Web 层（异常/CORS/Knife4j/校验）
    - fatjar-spring-boot-starter-mybatis   ：MyBatis-Plus + Druid
    - lombok(provided)
  跨模块依赖说明：本模块仅依赖 fatjar-fico-api（门面契约），永不依赖 fatjar-fico（实现），
                从根源规避 Maven 循环依赖。
  ====================================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.workspace.fatjar</groupId>
        <artifactId>fatjar-scm-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>fatjar-scm</artifactId>
    <name>fatjar-scm</name>
    <description>供应链管理模块业务实现 - entity/mapper/service/controller</description>
    <dependencies>
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-scm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- 跨模块门面契约：SCM 调用 FICO 预算校验 -->
        <dependency>
            <groupId>com.workspace.fatjar</groupId>
            <artifactId>fatjar-fico-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
